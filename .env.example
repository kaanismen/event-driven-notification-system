# Copy to .env to override defaults. Docker Compose reads .env automatically.
# .env is git-ignored; never commit real credentials.

# Host ports published by docker compose.
APP_PORT=8080
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=55432

# Password of the local development database (the default is for local use only).
POSTGRES_PASSWORD=notifier

# debug, info, warn or error.
LOG_LEVEL=info

# How long in-flight requests get to finish after SIGTERM (Go duration, e.g. 15s).
SHUTDOWN_TIMEOUT=15s
# After SIGTERM, /readyz fails for this long before the listener closes, so a load
# balancer stops routing here first (0s turns it off).
SHUTDOWN_DRAIN_DELAY=2s

# Delivery attempts per notification, first attempt included (1-20).
MAX_ATTEMPTS=8
# How far ahead scheduledAt may be (ADR-0017). Go durations have no days: 720h = 30 days.
MAX_SCHEDULE_AHEAD=720h
# Backoff between attempts (ADR-0002): the wait after attempt n is random between 0 and
# min(RETRY_MAX_DELAY, RETRY_BASE_DELAY * 2^(n-1)). RETRY_MAX_DELAY is at most 1h.
RETRY_BASE_DELAY=2s
RETRY_MAX_DELAY=5m
# Circuit breaker per channel (ADR-0015): this many transient failures in a row stop
# sending for BREAKER_COOLDOWN, then one probe message tests whether the provider is back.
BREAKER_FAILURE_THRESHOLD=10
BREAKER_COOLDOWN=30s

# Where notifications are delivered. Leave unset to use the bundled mock provider
# (http://mockprovider:8081/). For the real demo, paste your own webhook.site URL; it acts
# like a password, so keep it in .env only.
# PROVIDER_URL=https://webhook.site/your-unique-id
PROVIDER_TIMEOUT=10s

# Delivery engine. The rate limit applies per channel and per app instance (ADR-0003).
RATE_LIMIT_PER_SECOND=100
SENDERS_PER_CHANNEL=50
CLAIM_BATCH_SIZE=20
POLL_INTERVAL=250ms
LEASE_DURATION=30s
# Shares for high,normal,low priority when a channel has a backlog (ADR-0008).
PRIORITY_WEIGHTS=70,20,10

# Failure injection in the bundled mock provider (ADR-0014). All off by default.
# MOCK_FAIL_FIRST: the first N attempts of every message fail, then it is accepted.
# MOCK_FAILURE_RATE: share of requests (0 to 1) that fail at random; 1 = provider down.
# MOCK_FAILURE_STATUS: status of an injected failure (400-599), e.g. 503, 429 or 400.
# MOCK_RETRY_AFTER: Retry-After sent with failures (Go duration, 0s = none).
# MOCK_LATENCY: delay before every answer; above PROVIDER_TIMEOUT it causes timeouts.
MOCK_FAIL_FIRST=0
MOCK_FAILURE_RATE=0
MOCK_FAILURE_STATUS=503
MOCK_RETRY_AFTER=0s
MOCK_LATENCY=0s

# Database connection pool size of the app.
DB_MAX_CONNS=20

# Only needed when running the binary on the host instead of in Docker
# (`go run ./cmd/notifier` reads the process environment, not this file).
DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier?sslmode=disable
HTTP_ADDR=:8080
# PROVIDER_URL is also required there, e.g. http://localhost:8081/ with the mock running.
