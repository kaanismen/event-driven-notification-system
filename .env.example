# Copy to .env to override defaults. Docker Compose reads .env automatically.
# .env is git-ignored; never commit real credentials.

# Host ports published by docker compose.
APP_PORT=8080
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=55432

# Password of the local development database (the default is for local use only).
POSTGRES_PASSWORD=notifier

# debug, info, warn or error.
LOG_LEVEL=info

# How long in-flight requests get to finish after SIGTERM (Go duration, e.g. 15s).
SHUTDOWN_TIMEOUT=15s

# Only needed when running the binary on the host instead of in Docker
# (`go run ./cmd/notifier` reads the process environment, not this file).
DATABASE_URL=postgres://notifier:notifier@localhost:5432/notifier?sslmode=disable
HTTP_ADDR=:8080
